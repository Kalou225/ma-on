  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"import('fs').then(fs => fs.cpSync('dist', 'server/dist', { recursive: true }))\"",
